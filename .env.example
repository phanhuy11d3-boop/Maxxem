# CryptoSentinel Environment Variables Example
# Copy file này thành .env và điền giá trị thật của bạn
# Tuyệt đối không commit file .env lên GitHub!

# Supabase PostgreSQL Connection String
# Lấy từ Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Groq API Key (bắt đầu bằng gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (lấy từ @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (nơi nhận tin nhắn)
CHAT_ID=your_telegram_chat_id_here
