# CryptoSentinel Environment Variables Example
#
# Sao chép thành .env và điền giá trị. Không commit .env.
# v3 DEX-only: KHÔNG còn biến LLM nào — mọi alert là số liệu DEXScreener trực tiếp.

# PostgreSQL Supabase — lấy từ Dashboard > Database > Connection string (URI pooler).
DATABASE_URL=

# Telegram (BotFather)
BOT_TOKEN=

# Chat / channel kênh tín hiệu cộng đồng
CHAT_ID=

# [Optional] Kênh premium — chỉ nhận move nóng (m5 ≥8% hoặc bất kỳ khung ≥15%)
PREMIUM_CHAT_ID=

# Ops — heartbeat & admin alerts (không dùng kênh CHAT_ID; không trùng CHAT_ID)
ADMIN_CHAT_ID=
HEARTBEAT_CHAT_ID=

# 0/off = không gửi heartbeat/admin qua Telegram; 1/true/on = bật
ENABLE_OPS_TELEMETRY=0
